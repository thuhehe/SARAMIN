# The real values are committed in `.env`, which every mode loads — see the
# header there for why that is safe and what is deliberately *not* in it.
#
# This file exists for the two cases where you'd override rather than read:
#
#   1. Pointing at a local BB PM API instead of production. Copy the block
#      below into `.env.local` (gitignored) and adjust.
#   2. Turning the comment layer off for your own checkout: put an empty
#      `VITE_BBPM_SHARE_TOKEN=` in `.env.local`.
#
# Values in `.env.local` win over `.env`, and `*.local` is gitignored, so
# nothing you do here can reach the deployed site.

# Base URL of the BB PM API, no trailing slash.
VITE_BBPM_API_BASE=http://localhost:3022/api

# Token of a COMMENT-scoped share link. Create it in BB PM
# (Project → Share links) with the COMMENT scope enabled, then paste the
# 32-char token here. Half a credential: the passcode is the real gate and
# never belongs in any env file.
VITE_BBPM_SHARE_TOKEN=

# Optional: OAuth 2.1 client id, which turns on "Continue with BB PM". Must be
# registered against the exact origin you're serving from — the authorization
# server only redirects back to URIs on file. Register one with:
#
#   curl -X POST <API_BASE>/oauth/register \
#     -H 'Content-Type: application/json' \
#     -d '{"client_name":"Saramin VN Spec Site (local)",
#          "redirect_uris":["http://localhost:5173/oauth/callback"],
#          "token_endpoint_auth_method":"none",
#          "scope":"openid profile email"}'
#
# Leave blank and the unlock dialog offers the passcode only.
VITE_BBPM_OAUTH_CLIENT_ID=
