# Live comments (BB PM backend). Leave both unset and the comment layer
# is compiled out — the site behaves exactly as it did before.
#
# Both values are public: they ship in the client bundle. The token is
# only half of the credential; the passcode is what unlocks it, and that
# is never in the build. Never put a `bbpm_...` API key in here.

VITE_BBPM_API_BASE=https://pm.burningbros.kr/api

# Token of a COMMENT-scoped share link on the SRM project. Create it in
# BB PM (Project → Share links) with the COMMENT scope enabled, then
# paste the 32-char token here.
VITE_BBPM_SHARE_TOKEN=

# Optional: OAuth 2.1 client id, which turns on "Continue with BB PM" in
# the unlock dialog. Team members then sign in through BB PM instead of
# sharing a passcode, and their comments carry their real account.
#
# Also public, and safe to be: the client is registered as *public*
# (`token_endpoint_auth_method: none`), so there is no secret, and PKCE
# ties every code exchange to the browser that started it. Leave blank
# and the dialog offers the passcode only.
#
# Register it once per deployed origin (see README → Comments):
#   curl -X POST https://pm.burningbros.kr/api/oauth/register \
#     -H 'Content-Type: application/json' \
#     -d '{"client_name":"Saramin VN Spec Site",
#          "redirect_uris":["https://YOUR-DOMAIN/oauth/callback",
#                           "http://localhost:5173/oauth/callback"],
#          "token_endpoint_auth_method":"none",
#          "scope":"openid profile email"}'
VITE_BBPM_OAUTH_CLIENT_ID=
